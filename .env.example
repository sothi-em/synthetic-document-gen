# LLM endpoint settings (copy to .env and fill in real values).
# The chat (LLM) and embedding endpoints are configured independently.
# Both are OpenAI-compatible base URLs — for Ollama that is the /v1 route.
# Values saved in the web UI (Settings tab) override these.

# --- Chat (LLM) endpoint ---
# OpenAI-compatible base URL (Ollama /v1, llama.cpp, LM Studio, vLLM, ...)
LLM_HOST=http://localhost:11434/v1
LLM_MODEL=llama3.2-128k:latest
# LLM_API_KEY=
# Chat/completion request timeout in seconds (default: 300)
# LLM_TIMEOUT=300

# --- Embedding endpoint ---
EMBED_HOST=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text:latest
# EMBED_API_KEY=

# Optional: where the web UI stores settings saved from the Settings tab
# LLM_SETTINGS_PATH=./data/llm-settings.json

# Optional: ChromaDB persistence path (used by the labels subcommand)
CHROMA_DB_PATH=./data/chromadb

# --- Company database persistence ---
# Persistent single-file TinyDB store (companies, document types,
# generated-document records, user settings). When unset the DB is
# in-memory and ALL data is lost on server restart — set this to keep data.
# TINYDB_PATH=./data/companies.db

# --- PDF document generation ---
# Default directory for generated PDF documents. A directory saved from the
# web UI Settings tab overrides this; when neither is set, PDF generation
# is disabled (frontend) / rejected (API, exit error in the CLI).
# (Legacy name REPORTS_DIR is still honored as a fallback.)
# DOCUMENTS_DIR=./data/documents

# --- PDF rendering (WeasyPrint) ---
# Windows only: WeasyPrint needs pango/cairo/gdk-pixbuf DLLs and ignores
# PATH (it uses LOAD_LIBRARY_SEARCH_DEFAULT_DIRS). Point this at a directory
# containing the 64-bit DLLs, e.g. Inkscape's bin folder.
# WEASYPRINT_DLL_DIRECTORIES=C:\Program Files\Inkscape\bin
